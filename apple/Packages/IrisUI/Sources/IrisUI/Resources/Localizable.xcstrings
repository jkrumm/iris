{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ of %@" : {
      "comment" : "VoiceOver value of the player's timeline: elapsed of total, both as m:ss",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ von %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ of %2$@"
          }
        }
      }
    },
    "%lld of %lld steps done" : {
      "comment" : "VoiceOver value of an in-flight History row: finished steps of all steps.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld von %2$lld Schritten fertig"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld of %2$lld steps done"
          }
        }
      }
    },
    "Audio route: %@" : {
