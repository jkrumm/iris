    "A mode you pick wins over spoken words. With neither, Iris decides, and asks you when it is under 80 %% sure." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein gewählter Modus hat Vorrang vor gesprochenen Wörtern. Ohne beides entscheidet Iris und fragt nach, wenn die Sicherheit unter 80 %% liegt."
          }
        }
      }
    },
