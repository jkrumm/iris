          "stringUnit" : {
            "state" : "translated",
            "value" : "Wohin damit?"
          }
        }
      }
    },
    "Which microphone recording starts with, per audio route such as the car's Bluetooth. Kept on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit welchem Mikrofon die Aufnahme startet, je Audioroute, etwa das Bluetooth im Auto. Auf diesem Gerät gespeichert."
