{
  "name": "iris-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "secrets-run run --env-file=../.env.local.tpl -- bun run --hot src/index.ts",
    "lint": "cd .. && oxlint -c server/.oxlintrc.json server/src scripts",
    "format": "cd .. && oxfmt -c server/.oxfmtrc.json server/src scripts --write",
    "format:check": "cd .. && oxfmt -c server/.oxfmtrc.json server/src scripts --check",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "contracts:export": "bun src/contracts/cli.ts export",
    "contracts:check": "bun src/contracts/cli.ts check"
  },
  "dependencies": {
    "@parse/node-apn": "8.1.0",
    "@resvg/resvg-js": "2.6.2",
    "elysia": "1.4.30",
    "pele": "1.12.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "ajv": "8.20.0",
    "eslint-plugin-zod": "4.14.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "5.9.3"
  }
}
