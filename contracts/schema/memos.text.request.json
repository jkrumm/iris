{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "id": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "auto",
        "journal",
        "hermes",
        "tab",
        "chat",
        "transcribe"
      ],
      "type": "string"
    },
    "startedAt": {
      "type": "string"
    },
    "text": {
      "description": "Trimmed server-side; 1 to 20000 Unicode code points after trimming, else 400.",
      "type": "string"
    },
    "threadId": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "id",
    "mode",
    "startedAt",
    "text"
  ],
  "title": "memos.text.request",
  "type": "object"
}
