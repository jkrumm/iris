    "tabs": {
      "items": {
        "properties": {
          "agentState": {
            "enum": [
              "idle",
              "working",
              "blocked",
              "done",
              "unknown"
            ],
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "lastActivity": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "repo": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "repo",
          "label",
          "agentState",
          "lastActivity"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "tabs"
  ],
  "title": "herd.response",
  "type": "object"
}
