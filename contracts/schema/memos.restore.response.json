{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "actions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "archived": {
      "type": "boolean"
    },
    "audioSeconds": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string"
    },
    "deletedAt": {
      "type": "string"
    },
    "destinationRef": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "device": {
      "type": "string"
    },
    "done": {
      "type": "boolean"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "failedStep": {
      "anyOf": [
        {
          "enum": [
            "ingest",
            "transcribe",
            "route",
            "act",
            "summarize",
            "notify"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "favorite": {
      "type": "boolean"
    },
    "id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "auto",
        "journal",
        "hermes",
        "tab",
        "chat",
        "transcribe"
      ],
      "type": "string"
    },
    "purgeAt": {
      "type": "string"
    },
    "replyArtifacts": {
      "items": {
        "properties": {
          "assetId": {
            "type": "string"
          },
          "bytes": {
            "type": "integer"
          },
          "format": {
            "enum": [
              "markdown",
              "html"
            ],
            "type": "string"
          },
          "index": {
            "type": "integer"
          },
          "kind": {
            "enum": [
              "show",
              "doc"
            ],
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "index",
          "kind",
          "assetId",
          "bytes"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "replyBlocks": {
      "items": {
        "properties": {
          "height": {
            "type": "integer"
          },
          "index": {
            "type": "integer"
          },
          "kind": {
            "const": "mermaid",
            "type": "string"
          },
          "png": {
            "properties": {
              "dark": {
                "type": "string"
              },
              "light": {
                "type": "string"
              }
            },
            "required": [
              "light",
              "dark"
            ],
            "type": "object"
          },
          "svg": {
            "properties": {
              "dark": {
                "type": "string"
              },
              "light": {
                "type": "string"
              }
            },
            "required": [
              "light",
              "dark"
            ],
            "type": "object"
          },
          "width": {
            "type": "integer"
          }
        },
        "required": [
          "index",
          "kind",
          "width",
          "height",
          "svg",
          "png"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "replyText": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "route": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "segmentCount": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "startedAt": {
      "type": "string"
    },
    "state": {
      "enum": [
        "receiving",
        "received",
        "transcribed",
        "routed",
        "needs_route",
        "acted",
        "summarized",
        "notified",
        "failed"
      ],
      "type": "string"
    },
    "summary": {
      "anyOf": [
        {
          "properties": {
            "detail": {
              "type": "string"
            },
            "headline": {
              "type": "string"
            },
            "spoken": {
              "type": "string"
            }
          },
          "required": [
            "headline",
            "detail",
            "spoken"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "threadId": {
      "type": "string"
    },
    "transcript": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "typed": {
      "const": true,
      "type": "boolean"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "mode",
    "device",
    "startedAt",
    "state",
    "failedStep",
    "error",
    "segmentCount",
    "audioSeconds",
    "transcript",
    "route",
    "destinationRef",
    "replyText",
    "summary",
    "done",
    "favorite",
    "archived",
    "createdAt",
    "updatedAt"
  ],
  "title": "memos.restore.response",
  "type": "object"
}
