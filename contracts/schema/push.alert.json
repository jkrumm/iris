          "type": "string"
        },
        "thread-id": {
          "const": "memo",
          "type": "string"
        }
      },
      "required": [
        "alert",
        "mutable-content",
        "category",
        "thread-id",
        "sound"
      ],
      "type": "object"
    },
    "memo": {
      "type": "string"
    }
  },
  "required": [
    "aps",
    "memo"
  ],
  "title": "push.alert",
  "type": "object"
}
