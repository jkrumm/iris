<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jkrumm.iris-testflight-crashes</string>
  <!-- Hourly: scripts/testflight-crashes.ts reads new TestFlight crash reports from App Store Connect and files one factory
       Issue per crash signature (`rd issue iris`). Runs from the deploy clone like the poller; wrapped in `jobrun`
       (recorded in ~/.local/state/jobs, graded by `jobs-grade`). RunAtLoad is false: the first run follows
       `make testflight-crashes-baseline`. The flags here, the Makefile `testflight-crashes` target and StartInterval
       must stay in step. -->
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/jobrun</string>
    <string>com.jkrumm.iris-testflight-crashes</string>
    <string>--owner</string><string>iris</string>
    <string>--every</string><string>3600</string>
    <string>--timeout</string><string>600</string>
    <string>--</string>
    <string>bun</string>
    <string>__HOME__/.iris/app/scripts/testflight-crashes.ts</string>
  </array>
  <!-- launchd has no PATH: jobrun, secrets-run and rd live in ~/.local/bin, bun in ~/.bun/bin. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__HOME__/.local/bin:__HOME__/.bun/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>HOME</key><string>__HOME__</string>
  </dict>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><false/>
  <key>WorkingDirectory</key><string>__HOME__/.iris/app</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/iris-testflight-crashes.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/iris-testflight-crashes.log</string>
</dict>
</plist>
